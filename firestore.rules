rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // DEVELOPMENT MODE: Allow all reads and writes
      // Since you are using "Soft Auth" (managing users in the DB yourself)
      // and not Firebase Authentication yet, we must allow public access.
      allow read, write: if true;
    }
  }
}